<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build-time helper: writes the product icon (.ico) from Brand.cs, so the
    repository holds no image files. Run by src/Setup before it compiles.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Lbr.CadTools.IconGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\BajaAddIn\Util\Brand.cs" Link="Brand.cs" />
    <Compile Include="..\..\src\BajaAddIn\Util\BrandLeaf.cs" Link="BrandLeaf.cs" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
