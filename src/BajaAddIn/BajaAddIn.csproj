<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SolidWorks add-in. Builds on Windows with SolidWorks installed; see
    build/SolidWorksInterop.props for where the interop assemblies come from.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Lbr.CadTools.AddIn</RootNamespace>
    <AssemblyName>BajaAddIn</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <Import Project="..\..\build\SolidWorksInterop.props" />

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BajaAddIn.Core\BajaAddIn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SwSmokeTest" />
  </ItemGroup>
</Project>
